{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "endpoints": {
        "generateSummary": {
          "allowUnauthenticated": true
        },
        "checkInvite": {
          "allowUnauthenticated": true
        },
        "redeemInvite": {
          "allowUnauthenticated": true
        },
        "setTempPassword": {
          "allowUnauthenticated": true
        }
      },
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
