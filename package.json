{
  "name": "retro-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "VITE_USE_EMULATORS=true vite",
    "dev:local": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions \"npm run seed && npm run dev:emulators\"",
    "emulators": "firebase emulators:start --only auth,firestore",
    "emulators:all": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=retro-app-a95ca node functions/scripts/seed.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test:rules": "firebase emulators:exec --only firestore \"node --test --test-reporter=spec rules-tests/*.test.js\"",
    "test:auth": "npm --prefix functions run build && firebase emulators:exec --only functions,firestore,auth \"node --test --test-concurrency=1 --test-reporter=spec integration-tests/*.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "test": "npm run test:rules && npm run test:auth"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@mantine/core": "^7.17.3",
    "@mantine/hooks": "^7.17.3",
    "@mantine/notifications": "^7.17.5",
    "@tabler/icons-react": "^3.31.0",
    "canvas-confetti": "^1.9.3",
    "classnames": "^2.5.1",
    "firebase": "^11.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "sass": "^1.86.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.20.7",
    "@types/estree": "^1.0.7",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "14.27.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
